; Engine configuration file.
; Pocket Arcade, Godot edition: a faithful port of the Kotlin build-13 app (see docs/PORT_PARITY.md).

config_version=5

[application]

config/name="Pocket Arcade"
config/description="A pocket arcade hall: 11 machines, tickets, prizes."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"
; Android Back is the game's own (Back pauses a round or closes an overlay), never "quit".
config/quit_on_go_back=false
boot_splash/show_image=false
boot_splash/bg_color=Color(0.07058824, 0.039215688, 0.14117648, 1)
run/low_processor_mode=false

[audio]

driver/enable_input=false
; The soundtrack's tempos make each loop exactly periodic at 48 kHz (engine/audio/Tracks).
driver/mix_rate=48000
general/default_playback_type.web=0

[debug]

gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_private_class_variable=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/confusable_local_declaration=0
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/inference_on_variant=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_cast=0

[display]

window/size/viewport_width=432
window/size/viewport_height=960
window/size/window_width_override=432
window/size/window_height_override=960
window/stretch/mode="disabled"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[gui]

common/snap_controls_to_pixels=true
theme/default_font_antialiasing=1

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true
buffering/agile_event_flushing=true
pointing/android/enable_long_press_as_right_click=false
pointing/android/enable_pan_and_scale_gestures=false

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.07058824, 0.039215688, 0.14117648, 1)
limits/opengl/max_renderable_lights=32
lights_and_shadows/directional_shadow/size=1024
2d/snap/snap_2d_transforms_to_pixel=false
