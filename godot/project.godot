config_version=5

[application]
config/name="Pocket Arcade"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.04,0.04,0.1,1)

[autoload]
SaveStore="*res://scripts/save_store.gd"

[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=432
window/size/window_height_override=768
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
limits/opengl/max_lights_per_object=4
limits/global_shader_variables/buffer_size=128
environment/defaults/default_clear_color=Color(0.018,0.014,0.055,1)

[input_devices]
pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[physics]
common/physics_ticks_per_second=120

[audio]
driver/enable_input=false
